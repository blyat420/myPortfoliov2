---
// Scroll-to-top progress ring (bottom left) + audio player (bottom right).
// Lives outside the Barba container so music keeps playing between pages.
import fs from 'node:fs';
import path from 'node:path';

const dir = path.resolve(process.cwd(), 'public', 'audio');
const tracks = fs.existsSync(dir)
  ? fs
      .readdirSync(dir)
      .filter((f) => /\.(mp3|ogg|wav|m4a|aac|flac)$/i.test(f))
      .map((f) => ({
        src: `/audio/${encodeURIComponent(f)}`,
        title: f
          .replace(/\.[^.]+$/, '')
          .replace(/\s*\(.*?\)\s*/g, ' ')
          .replace(/\s+-\s+[^-]*$/, '')
          .trim(),
      }))
  : [];
const R = 22;
const C = 2 * Math.PI * R;
---

<img class="cursor-tag" src="/cursor-click.svg" alt="" width="794" height="197" aria-hidden="true" data-cursor-tag />

<button class="ring" type="button" aria-label="Scroll to top" data-ring>
  <svg viewBox="0 0 52 52" aria-hidden="true">
    <circle class="ring__bg" cx="26" cy="26" r={R}></circle>
    <circle class="ring__fg" cx="26" cy="26" r={R} stroke-dasharray={C} stroke-dashoffset={C} data-ring-fg></circle>
    <path class="ring__arrow" d="M26 33V19M19.5 25.5L26 19l6.5 6.5"></path>
  </svg>
</button>

{
  tracks.length > 0 && (
    <div class="player" data-player data-tracks={JSON.stringify(tracks)} role="group" aria-label="Music player">
      <p class="player__title" data-title aria-live="polite" />
      <input class="player__bar" type="range" min="0" max="1000" value="0" step="1" aria-label="Seek" data-seek />
      <div class="player__row">
        <button type="button" class="pbtn" data-shuffle aria-pressed="true" aria-label="Shuffle">
          <svg viewBox="0 0 24 24"><path d="M3 7h3.5c2 0 3.2 1 4.3 2.8l2.4 4.4c1.1 1.8 2.3 2.8 4.3 2.8H21M3 17h3.5c2 0 3.2-1 4.3-2.8M13.2 9.8c1.1-1.8 2.3-2.8 4.3-2.8H21M18.5 4.5L21 7l-2.5 2.5M18.5 14.5L21 17l-2.5 2.5" /></svg>
        </button>
        <button type="button" class="pbtn" data-prev aria-label="Previous track">
          <svg viewBox="0 0 24 24" class="fill"><path d="M11 6v12l-8.5-6zM21 6v12l-8.5-6z" /></svg>
        </button>
        <button type="button" class="pbtn pbtn--play" data-play aria-label="Play">
          <svg viewBox="0 0 24 24" class="fill" data-icon-play><path d="M8.5 5.5v13l11-6.5z" /></svg>
          <svg viewBox="0 0 24 24" class="fill" data-icon-pause hidden><path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" /></svg>
        </button>
        <button type="button" class="pbtn" data-next aria-label="Next track">
          <svg viewBox="0 0 24 24" class="fill"><path d="M13 6v12l8.5-6zM3 6v12l8.5-6z" /></svg>
        </button>
        <button type="button" class="pbtn" data-repeat aria-pressed="false" aria-label="Repeat track">
          <svg viewBox="0 0 24 24"><path d="M4 11V9a2 2 0 0 1 2-2h13M16 4l3 3-3 3M20 13v2a2 2 0 0 1-2 2H5M8 20l-3-3 3-3" /></svg>
        </button>
      </div>
    </div>
  )
}
