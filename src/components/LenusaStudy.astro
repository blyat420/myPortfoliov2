---
// Journey-style detail page (Lenusa, Random Design): intro, a scroll-driven timeline, optional gallery.
import { lenusa } from '../data/lenusa';
const { d = lenusa } = Astro.props as { d?: typeof lenusa };
---

<section class="cs-sec">
  <div class="cs-wrap ln-about" data-reveal>
    <h2 class="ln-h2">{d.aboutTitle}</h2>
    {d.about.map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="cs-sec cs-sec--dark ln-journey">
  <div class="cs-wrap">
    <h2 class="ln-h2" data-reveal>My journey</h2>
    <p class="ln-sub" data-reveal>{d.journeySub}</p>
    <div class="ln-list" data-timeline>
      <span class="ln-line" aria-hidden="true"><span class="ln-fill" data-ln-fill></span></span>
      <ol class="ln-steps">
      {
        d.steps.map((s, i) => (
          <li class="ln-step" data-ln-step>
            <span class="ln-dot" aria-hidden="true" data-ln-dot></span>
            <div class="ln-text" data-ln-text>
              <span class="ln-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul class="ln-tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
            <figure class="ln-media" data-ln-media>
              <img src={s.img} alt={s.alt} width="760" height="400" loading="lazy" decoding="async" />
            </figure>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

{
  d.gallery.length > 0 && (
    <section class="cs-sec ln-gallery">
      <div class="cs-wrap">
        <h2 class="ln-h2" data-reveal>Selected work</h2>
        <p class="ln-sub" data-reveal>{d.gallerySub}</p>
        {d.gallery.map((g) => (
          <div class="ln-group" data-reveal>
            <h3>{g.title}</h3>
            <p class="ln-note">{g.note}</p>
            <ul class={`ln-grid ln-grid--${g.cols}`} style={`--ratio:${g.ratio}`}>
              {g.items.map((i) => (
                <li class={i.wide ? 'ln-wide' : undefined}><img src={i.src} alt={i.alt} loading="lazy" decoding="async" /></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )
}

<p class="ln-foot" data-reveal>{d.footer}</p>
